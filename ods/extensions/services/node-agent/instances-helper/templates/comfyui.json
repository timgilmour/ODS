{
  "image": "ods-comfyui:live",
  "internal_port": 8188,
  "service": {
    "restart": "unless-stopped",
    "devices": [
      "/dev/dri:/dev/dri",
      "/dev/kfd:/dev/kfd"
    ],
    "group_add": [
      "44",
      "992"
    ],
    "security_opt": [
      "no-new-privileges:true"
    ],
    "shm_size": "8g",
    "command": [
      "/bin/sh",
      "-c",
      "/opt/comfyui-gfx1151-utils/check-comfyui.sh && python3 /opt/ComfyUI/main.py --listen 0.0.0.0 --use-flash-attention --user-directory /data/user --output-directory /data/output --input-directory /data/input --temp-directory /data/temp"
    ],
    "healthcheck": {
      "test": [
        "CMD",
        "curl",
        "-f",
        "http://127.0.0.1:8188/"
      ],
      "interval": "30s",
      "timeout": "10s",
      "retries": 3,
      "start_period": "120s"
    },
    "logging": {
      "driver": "json-file",
      "options": {
        "max-size": "10m",
        "max-file": "3"
      }
    }
  },
  "environment": {
    "MIOPEN_FIND_MODE": "FAST",
    "TORCH_ROCM_AOTRITON_ENABLE_EXPERIMENTAL": "1"
  },
  "env_allow": [],
  "volumes": [
    "{ods_dir}/data/comfyui/ComfyUI:/opt/ComfyUI:ro,z",
    "{data_dir}/user:/data/user:z",
    "{data_dir}/output:/data/output:z",
    "{data_dir}/input:/data/input:z",
    "{data_dir}/temp:/data/temp:z",
    "{data_dir}/miopen:/root/.config/miopen:z"
  ],
  "per_instance_dirs": [
    "user",
    "output",
    "input",
    "temp",
    "miopen"
  ],
  "route": null
}
