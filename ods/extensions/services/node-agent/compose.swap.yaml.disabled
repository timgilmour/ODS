# Swap-control overlay for the node-agent — OPT-IN, remote-node only.
# Same `.disabled` convention as compose.yaml.disabled (keep it out of the
# local stack's -f set). Activate by adding it to the compose call:
#
#   docker compose -f ods/extensions/services/node-agent/compose.yaml.disabled \
#                  -f ods/extensions/services/node-agent/compose.swap.yaml.disabled \
#                  up -d --build
#
# This is the docker.sock-free alternative for model swapping: the agent
# reads the compose-*.yaml profile set (ro) and writes request.json into the
# ctl dir; the host-side swap-helper (swap-helper/swap-helper.sh, run as the
# operator via cron @reboot) is the only thing that touches docker.
services:
  ods-node-agent:
    environment:
      NODE_VLLM_DIR: /vllm
      NODE_SWAP_CTL_DIR: /swap-ctl
      # Settings documents + harvested catalogs (Plan C2). Needs rw: the
      # agent WRITES <profile>.json here (PUT /settings) — the /vllm mount
      # is deliberately ro, which is why this is a separate dir. The
      # host-side swap-helper reads the documents and writes catalog-*.json
      # into the same dir (its 4th positional arg names the host path).
      NODE_SETTINGS_DIR: /settings
    volumes:
      # Required, no defaults (`:?` fails loudly at `docker compose config`
      # time): these are one specific machine's paths — a baked-in default
      # is wrong everywhere else, and a wrong-but-plausible mount fails
      # SILENTLY as "no profiles found". Set them in the node's durable
      # .env beside this file.
      - ${HOST_VLLM_DIR:?path to the node's vllm profile dir (e.g. ~/vllm)}:/vllm:ro
      - ${HOST_SWAP_CTL_DIR:?path to the swap-ctl dir (e.g. ~/vllm/swap-ctl)}:/swap-ctl:rw
      - ${HOST_SETTINGS_DIR:?path to the settings dir (e.g. ~/vllm/settings)}:/settings:rw
