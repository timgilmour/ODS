# hipfire — RDNA-native LLM inference engine, containerized for ODS.
#
# Two stages: the build needs the ROCm SDK base only for parity with the
# runtime (the cargo build itself needs no GPU — ROCm/HIP is dlopen'd at
# runtime), and the runtime needs hipcc + HIP headers because kernels are
# JIT-compiled on first use.
#
# Rewritten 2026-08-16 for the post-July upstream restructure (repo moved to
# warpfront/hipfire; verified against the pinned tree):
#   - The Bun/TypeScript CLI (cli/index.ts) is GONE. The CLI is now a Rust
#     binary (`cargo build -p hipfire-cli` → target/release/hipfire). No Bun
#     in the runtime image anymore.
#   - Kernels are no longer pre-compiled at build time. Every .hip source and
#     its helper headers are embedded in the daemon via include_str! and
#     JIT-compiled by hipcc on first use, cached under HIPFIRE_KERNEL_CACHE
#     with hash sidecars keyed on source+arch+flags+toolchain+ABI. The old
#     "compile 528 kernels, gate on a count" stage is obsolete. Baking
#     pre-compiled blobs was considered and rejected: packaged blobs carry
#     toolchain_id="" hashes which only validate on a hipcc-FREE runtime
#     (compiler.rs cache_hash vs packaging_hash); with hipcc present — which
#     JIT needs anyway — they hash-mismatch and everything recompiles. The
#     compose-mounted cache volume makes JIT a once-per-toolchain cost.
#   - The finish-reason.patch is RETIRED. It patched cli/index.ts, which no
#     longer exists; the Rust rewrite carries the terminal finish_reason
#     rule natively (see cli tests asserting finish_reason == "tool_calls").
#     Verified behaviorally at deploy, not assumed — see README.
#   - Config discovery roots at $HIPFIRE_HOME (falling back to $HOME/.hipfire).
#     NOTE: upstream's own Containerfile sets HIPFIRE_DIR, which nothing in
#     the tree reads — the real env var is HIPFIRE_HOME (hipfire-config
#     lib.rs discover()). We set both HOME and HIPFIRE_HOME explicitly.
#   - The daemon path is taken from HIPFIRE_DAEMON_BIN (honored by the CLI).
#
# Pinned to a master commit, NOT a release tag: the last tag (v0.2.1) predates
# both the MoE quantizer fix and the whole Rust-CLI restructure. Upstream's
# Cargo.toml says 0.3.0 but no v0.3.0 tag exists yet. Bump deliberately,
# never float.
ARG HIPFIRE_REF=8510ca5f247da2b87082e0ae7218c3521bdb1032

# ─────────────────────────────────────────────────────────────
# Stage 1: builder — Rust daemon + Rust CLI
# ─────────────────────────────────────────────────────────────
# Same ROCm base family as the runtime (host runs ROCm 7.2.4). The 7.2.4
# non-"-complete" dev image ships hipcc + HIP headers, which is all the JIT
# path needs; the build stage itself only needs the matching system libs.
FROM rocm/dev-ubuntu-24.04:7.2.4 AS builder

ARG HIPFIRE_REF

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential git curl ca-certificates pkg-config libssl-dev \
    && rm -rf /var/lib/apt/lists/*

ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo
ENV PATH=/opt/cargo/bin:$PATH
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
      | sh -s -- -y --default-toolchain stable --profile minimal

WORKDIR /src
RUN git clone https://github.com/warpfront/hipfire.git . \
 && git checkout --detach "${HIPFIRE_REF}"

# The daemon is an *example* target of hipfire-runtime, not a bin — this is
# how upstream's own Containerfile builds it. Default features already pull
# in the arch crates; deltanet is additive.
RUN cargo build --release --locked --features deltanet \
        --example daemon -p hipfire-runtime
RUN cargo build --release --locked -p hipfire-cli

# ─────────────────────────────────────────────────────────────
# Stage 2: runtime — HIP runtime + hipcc (JIT) + daemon + CLI
# ─────────────────────────────────────────────────────────────
FROM rocm/dev-ubuntu-24.04:7.2.4 AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Config/model/registry discovery roots at HIPFIRE_HOME (HOME/.hipfire as
# fallback — keep both aligned so nothing diverges). The models volume mounts
# at /opt/hipfire/.hipfire/models, same path as the pre-rewrite image, so the
# compose mounts are unchanged.
ENV HOME=/opt/hipfire \
    HIPFIRE_HOME=/opt/hipfire/.hipfire \
    HIPFIRE_DAEMON_BIN=/opt/hipfire/.hipfire/bin/daemon \
    HIPFIRE_KERNEL_CACHE=/opt/hipfire/.hipfire_kernels \
    HIP_PATH=/opt/rocm
WORKDIR /opt/hipfire

COPY --from=builder /src/target/release/examples/daemon \
                    /opt/hipfire/.hipfire/bin/daemon
COPY --from=builder /src/target/release/hipfire /usr/local/bin/hipfire

COPY hipfire-entrypoint.sh /usr/local/bin/hipfire-entrypoint.sh
RUN chmod +x /usr/local/bin/hipfire-entrypoint.sh

EXPOSE 11435

# /health returns 503 while a model loads; a cold load can take minutes, and
# the first load after a toolchain change also JIT-compiles the kernels the
# model touches.
HEALTHCHECK --interval=30s --timeout=5s --start-period=300s --retries=5 \
  CMD curl -fsS http://127.0.0.1:11435/health || exit 1

ENTRYPOINT ["/usr/local/bin/hipfire-entrypoint.sh"]
