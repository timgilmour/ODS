index 00000000..7d8a4aef
--- /dev/null
+++ b/cli/finish_reason.test.ts
@@ -0,0 +1,64 @@
+// Bun-native test for the terminal finish_reason selection.
+//
+// Regression: with HIPFIRE_QWEN35_GRAMMAR=0 the daemon's own tool-call
+// extraction comes back empty, so its `done` envelope reports
+// finish_reason="stop". The CLI then successfully recovers the call from
+// text (parseToolCalls, the #111 stopgap), streams tool_call deltas — and
+// used to close the stream with `daemonFR ?? "tool_calls"`, which takes the
+// daemon's stale "stop" because it is non-null. Clients received tool calls
+// alongside finish_reason="stop".
+//
+// The daemon's field answers "what did I extract"; it is not "what is this
+// response". Once we have emitted tool_call deltas the response IS a
+// tool-call response, and the only daemon verdict that may override that is
+// "length" — a call truncated by the token budget really is a length stop.
+// That precedence is the daemon's own documented rule
+// (crates/hipfire-runtime/examples/daemon.rs: "Length-cap wins over
+// tool_calls").
+//
+// Run: bun test cli/finish_reason.test.ts
+
+import { test, expect } from "bun:test";
+import { terminalFinishReason } from "./finish_reason";
+
+test("daemon says stop but we emitted tool calls -> tool_calls", () => {
+  // The live bug, exactly.
+  expect(terminalFinishReason("stop", true)).toBe("tool_calls");
+});
+
+test("daemon says length and we emitted tool calls -> length wins", () => {
+  // A tool call cut off by max_tokens is a length stop; the client needs to
+  // tell that apart from a complete call and retry with a bigger budget.
+  expect(terminalFinishReason("length", true)).toBe("length");
+});
+
+test("daemon reported nothing and we emitted tool calls -> tool_calls", () => {
+  // Older daemon builds omit the field entirely.
+  expect(terminalFinishReason(null, true)).toBe("tool_calls");
+  expect(terminalFinishReason(undefined, true)).toBe("tool_calls");
+});
+
+test("daemon agrees we emitted tool calls -> tool_calls", () => {
+  expect(terminalFinishReason("tool_calls", true)).toBe("tool_calls");
+});
+
+test("no tool calls emitted -> stop", () => {
+  expect(terminalFinishReason("stop", false)).toBe("stop");
+  expect(terminalFinishReason(null, false)).toBe("stop");
+});
+
+test("no tool calls emitted but daemon says length -> length", () => {
+  expect(terminalFinishReason("length", false)).toBe("length");
+});
+
+test("never claims tool_calls when we emitted none", () => {
+  // The inverse of the bug: we may only report tool_calls when tool_calls
+  // actually went out on the wire, whatever the daemon believes.
+  expect(terminalFinishReason("tool_calls", false)).toBe("stop");
+});
+
+test("an unrecognised daemon value is clamped, not passed through", () => {
+  // Only stop | length | tool_calls are OpenAI-valid.
+  expect(terminalFinishReason("banana", false)).toBe("stop");
+  expect(terminalFinishReason("banana", true)).toBe("tool_calls");
+});
