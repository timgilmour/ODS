index 00000000..5a7f99c8
--- /dev/null
+++ b/cli/finish_reason.ts
@@ -0,0 +1,45 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright (c) 2026 Kaden Schutt
+
+//! Terminal `finish_reason` selection for the OpenAI-compatible stream.
+//
+// Side-effect free and dependency-free on purpose: index.ts has top-level
+// side effects, so anything defined there is unreachable from a test. The
+// existing cli/parse_tool_calls.test.ts works around that by DUPLICATING the
+// parser under a "keep in sync" comment — a second copy that can drift
+// silently. This module exists so the rule below has exactly one home.
+
+export type FinishReason = "stop" | "length" | "tool_calls";
+
+/**
+ * Decide the `finish_reason` for the chunk that closes a chat-completion
+ * stream.
+ *
+ * `daemonFinishReason` is what the Rust daemon reported in its `done`
+ * envelope, which answers "what did *I* extract from the generated text" —
+ * NOT "what is this response". The distinction is load-bearing: with the
+ * qwen35 grammar disabled the daemon's own extraction finds nothing and it
+ * reports `stop`, while the CLI still recovers the call from text and
+ * streams tool_call deltas. Preferring the daemon there (`daemonFR ??
+ * "tool_calls"`) shipped tool calls to clients under `finish_reason: "stop"`.
+ *
+ * So: once tool calls have gone out on the wire, the response is a tool-call
+ * response. The single exception is `length` — a call truncated by the token
+ * budget really is a length stop, and the client needs to tell that apart
+ * from a complete call so it can retry with a larger budget. That precedence
+ * mirrors the daemon's own documented rule ("Length-cap wins over
+ * tool_calls", crates/hipfire-runtime/examples/daemon.rs).
+ *
+ * The converse also holds and is enforced here: we never claim `tool_calls`
+ * when none were emitted, whatever the daemon believes. Any value outside
+ * the OpenAI-valid set is clamped rather than passed through.
+ */
+export function terminalFinishReason(
+  daemonFinishReason: string | null | undefined,
+  emittedToolCalls: boolean,
+): FinishReason {
+  if (daemonFinishReason === "length") {
+    return "length";
+  }
+  return emittedToolCalls ? "tool_calls" : "stop";
+}
