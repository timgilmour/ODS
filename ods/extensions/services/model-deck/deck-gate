#!/usr/bin/env bash
# deck-gate — run the Model Deck browser gates.
# Tier 1 (default) is deterministic and runs anywhere. Tier 2 (--live) is
# READ-ONLY against a live deck and only checks fixture fidelity.
set -euo pipefail

EXT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
UI_DIR="$EXT_DIR/ui"
REPORT_DIR="${REPORT_DIR:-$HOME/notes/evidence/deck-gates}"
DECK_URL="${DECK_URL:-http://127.0.0.1:3015}"

TIER="fixture"
PATTERN=""
ALLOW_SHRINK=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --live) TIER="live"; shift ;;
    --capture) TIER="capture"; shift ;;
    --report-dir) REPORT_DIR="$2"; shift 2 ;;
    -k) PATTERN="$2"; shift 2 ;;
    # R17 (controller ruling): --capture default-unions with the committed
    # fixture (a token/shape key, once known, survives a routine
    # re-capture). This opts back into the old raw-overwrite behavior, for
    # deliberately retiring a stale path/token — only meaningful with
    # --capture; run.mjs ignores it on every other tier.
    --allow-shrink) ALLOW_SHRINK="--allow-shrink"; shift ;;
    *) echo "deck-gate: unknown argument $1" >&2; exit 2 ;;
  esac
done

command -v google-chrome >/dev/null 2>&1 || {
  echo "deck-gate: REFUSED — google-chrome not found. playwright-core drives the" >&2
  echo "system Chrome (channel: chrome) and does not download a browser." >&2
  exit 2
}

if [[ ! -f "$UI_DIR/dist/index.html" ]]; then
  echo "deck-gate: REFUSED — ui/dist is missing. Run: (cd ui && npm run build)" >&2
  exit 2
fi

# Fix round 1, items 2+3. The staleness guard must watch everything Vite
# actually bundles, not just ui/src: ui/index.html (the Vite entry),
# ui/vite.config.ts, and ui/public/ all change the built output without
# touching ui/src, which would otherwise give a false PASS against a stale
# dist. ui/gates is deliberately EXCLUDED — gate .mjs is never bundled, so
# watching it would refuse on every gate edit for no reason.
#
# A missing required path must refuse rather than pass silently: `find` on a
# nonexistent path writes to stderr and produces no matches, so the `[[ -n
# ... ]]` staleness test below would read empty and let a build with no
# source tree through as "fresh". Check existence explicitly first.
WATCH_PATHS=("$UI_DIR/src" "$UI_DIR/index.html" "$UI_DIR/vite.config.ts")
for p in "${WATCH_PATHS[@]}"; do
  if [[ ! -e "$p" ]]; then
    echo "deck-gate: REFUSED — $p is missing; cannot verify dist freshness." >&2
    exit 2
  fi
done
[[ -d "$UI_DIR/public" ]] && WATCH_PATHS+=("$UI_DIR/public")

if [[ -n "$(find "${WATCH_PATHS[@]}" -newer "$UI_DIR/dist/index.html" -print -quit)" ]]; then
  echo "deck-gate: REFUSED — ui/dist is older than one of: ui/src, ui/index.html," >&2
  echo "ui/vite.config.ts, ui/public. Run: (cd ui && npm run build)" >&2
  echo "A gate against a stale bundle proves nothing about the code you just wrote." >&2
  exit 2
fi

if [[ "$TIER" != "fixture" ]]; then
  curl -sf --max-time 5 "$DECK_URL/health" >/dev/null || {
    echo "deck-gate: REFUSED — deck unreachable at $DECK_URL" >&2
    exit 2
  }
fi

mkdir -p "$REPORT_DIR"
cd "$UI_DIR"
exec node gates/run.mjs --tier "$TIER" --report-dir "$REPORT_DIR" \
     --deck-url "$DECK_URL" ${PATTERN:+--pattern "$PATTERN"} $ALLOW_SHRINK
